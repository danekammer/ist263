<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Participation 11</title>
</head>
<body>
    <h1>Participation 11</h1>

    <a href="javascript:void(0)" id="msgLink">Roll over for a message</a>

    <script>
        var link = document.getElementById("msgLink");
        var alertShown = false;

        link.addEventListener("mouseenter", function () {
            if (!alertShown) {
                alertShown = true;
                alert("My first JavaScript program!");
            }
        });

        link.addEventListener("mouseleave", function () {
            alertShown = false;
        });
    </script>
</body>
</html>